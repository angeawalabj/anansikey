# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build outputs
dist/
out/
*.vsix

# Environment files — NEVER commit real credentials
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.example
!.env.test

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Temporary
tmp/
temp/

# Scaffold output — `pnpm run scaffold` writes here, at the repo root.
# Leading slash is required: an unanchored `providers/` would also match
# packages/core/providers/, i.e. the entire provider registry.
/providers/

# Local-only bootstrap helper
/scripts/git-init.sh

# pnpm-lock.yaml is intentionally NOT ignored — see DEPENDENCIES.md.
